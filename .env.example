# DomainFolio marketplace — environment template.
# Copy to .env (root) and apps/api/.env. NEVER commit a filled-in .env.
# Secrets are empty by default: the app fails closed without them.

# --- Core ---
ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# --- Database / queues / search (local dev defaults) ---
DATABASE_URL=postgresql+psycopg://domainfolio:domainfolio@localhost:5432/domainfolio
POSTGRES_PASSWORD=domainfolio
REDIS_URL=redis://localhost:6379/0
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# --- Auth secrets (REQUIRED — no defaults; generate with e.g. openssl rand -hex 32) ---
JWT_SECRET=
SESSION_SECRET=

# --- Escrow (sandbox only until approved) ---
ESCROW_PROVIDER=stub
ESCROW_API_BASE_URL=
ESCROW_API_KEY=
ESCROW_WEBHOOK_SECRET=

# --- Stripe (platform billing; Connect NOT approved — leave disabled) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ENABLED=false

# --- Object storage (S3-compatible; later stages) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- SMTP (transactional mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@domainfolio.site
